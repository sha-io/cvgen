        "live_url": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "technologies": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "description",
        "technologies"
      ],
      "type": "object"
    },
    "Skills": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "type": "object"
    }
  }
}