{
  "$ref": "#/definitions/CVProfile",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CVProfile": {
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "description": "Path to the JSON schema for validation. (e.g., \"./schema.json\")",
          "examples": [
            "./schema.json"
          ],
          "type": "string"
        },
        "certifications": {
          "description": "Professional licenses and certifications.",
          "items": {
            "$ref": "#/definitions/Certification"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "education": {
          "description": "Academic background history.",
          "items": {
            "$ref": "#/definitions/Education"
          },
          "minItems": 1,
          "type": "array"
        },
        "experiences": {
          "description": "Professional work history.",
          "items": {
            "$ref": "#/definitions/Experience"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "languages": {
          "description": "Spoken and written languages.",
          "items": {
            "$ref": "#/definitions/Language"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "profile": {
          "$ref": "#/definitions/ProfileDetails",
          "description": "Personal and contact information."
        },
        "projects": {
          "description": "Independent or open-source work.",
          "items": {
            "$ref": "#/definitions/Project"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "skills": {
          "$ref": "#/definitions/Skills",
          "description": "Technical and soft skills."
        },
        "summary": {
          "description": "Professional summary or objective statement. (e.g., \"Motivated engineer...\")",
          "examples": [
            "Motivated engineer with a focus on high-performance web systems."
          ],
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "profile",
        "summary",
        "education",
        "skills"
      ],
      "type": "object"
    },
    "Certification": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "description": "Date the certificate was earned. (e.g., \"2022-05-15\")",
          "examples": [
            "2022-05-15"
          ],
          "pattern": "^(\\d{4}-\\d{2}-\\d{2}|(0[1-9]|1[0-2])\\/(19|20)\\d{2})$",
          "type": "string"
        },
        "expiry_date": {
          "description": "Date the certificate expires. (e.g., \"2025-05-15\")",
          "examples": [
            "2025-05-15"
          ],
          "pattern": "^(\\d{4}-\\d{2}-\\d{2}|(0[1-9]|1[0-2])\\/(19|20)\\d{2})$",
          "type": [
            "string",
            "null"
          ]
        },
        "issuer": {
          "description": "Organization that issued the certificate. (e.g., \"Amazon Web Services\")",
          "examples": [
            "Amazon Web Services"
          ],
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "description": "Official name of the certification. (e.g., \"AWS Certified Solutions Architect\")",
          "examples": [
            "AWS Certified Solutions Architect"
          ],
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "issuer",
        "date"
      ],
      "type": "object"
    },
    "Education": {
      "additionalProperties": false,
      "properties": {
        "achievements": {
          "description": "Academic honors or activities. (e.g., [\"Dean's List 2017\"])",
          "examples": [
            [
              "Dean's List 2017",
              "Hackathon Winner"
            ]
          ],
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": [
            "array",
            "null"
          ]
        },
        "degree": {
          "description": "Degree or qualification obtained. (e.g., \"Bachelor of Science\")",
          "examples": [
            "Bachelor of Science"
          ],
          "minLength": 1,
          "type": "string"
        },
        "end_date": {
          "description": "Graduation date. (e.g., \"2018-06-01\")",
          "examples": [
            "2018-06-01"
          ],
          "pattern": "^(\\d{4}-\\d{2}-\\d{2}|(0[1-9]|1[0-2])\\/(19|20)\\d{2})$",
          "type": "string"
        },
        "field_of_study": {
          "description": "Specific area of study. (e.g., \"Computer Science\")",
          "examples": [
            "Computer Science"
          ],
          "minLength": 1,
          "type": "string"
        },
        "gpa": {
          "description": "Grade Point Average. (e.g., \"3.8/4.0\")",
          "examples": [
            "3.8/4.0"
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "institution": {
          "description": "Name of the school or university. (e.g., \"University of Technology\")",
          "examples": [
            "University of Technology"
          ],
          "minLength": 1,
          "type": "string"
        },
        "location": {
          "description": "Campus or city of the institution. (e.g., \"New York, USA\")",
          "examples": [
            "New York, USA"
          ],
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "start_date": {
          "description": "Enrollment start date. (e.g., \"2014-09-01\")",
          "examples": [
            "2014-09-01"
          ],
          "pattern": "^(\\d{4}-\\d{2}-\\d{2}|(0[1-9]|1[0-2])\\/(19|20)\\d{2})$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "institution",
        "degree",
        "field_of_study",
        "end_date"
      ],
      "type": "object"
    },
    "Experience": {
      "additionalProperties": false,
      "properties": {
        "achievements": {
          "description": "List of key contributions. (e.g., [\"Reduced load times by 40%\"])",
          "examples": [
            [
              "Reduced load times by 40%",
              "Led a team of 3 developers"
            ]
          ],
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": [
            "array",
            "null"
          ]
        },
        "company": {
          "description": "Name of the organization. (e.g., \"Tech Solutions Inc.\")",
          "examples": [
            "Tech Solutions Inc."
          ],
          "minLength": 1,
          "type": "string"
        },
        "description": {
          "description": "Overview of roles and responsibilities. (e.g., \"Developed scalable web applications...\")",
          "examples": [
            "Developed and maintained scalable web applications using React."
          ],
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "end_date": {
          "description": "Employment end date or 'Present'. (e.g., \"Present\")",
          "examples": [
            "Present"
          ],
          "pattern": "^(\\d{4}-\\d{2}-\\d{2}|(0[1-9]|1[0-2])/(19|20)\\d{2}|[Pp][Rr][Ee][Ss][Ee][Nn][Tt])$",
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "description": "Work location (e.g., \"Remote\" or \"City, State\").",
          "examples": [
            "Remote"
          ],
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "position": {
          "description": "Job title held at the organization. (e.g., \"Frontend Developer\")",
          "examples": [
            "Frontend Developer"
          ],
          "minLength": 1,
          "type": "string"
        },
        "start_date": {
          "description": "Employment start date. (e.g., \"2020-01-01\")",
          "examples": [
            "2020-01-01"
          ],
          "pattern": "^(\\d{4}-\\d{2}-\\d{2}|(0[1-9]|1[0-2])\\/(19|20)\\d{2})$",
          "type": "string"
        }
      },
      "required": [
        "company",
        "position",
        "start_date"
      ],
      "type": "object"
    },
    "Language": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "description": "Name of the language. (e.g., \"English\")",
          "examples": [
            "English"
          ],
          "type": "string"
        },
        "proficiency": {
          "$ref": "#/definitions/LanguageProficiency",
          "description": "Level of mastery. (e.g., \"Native\")",
          "examples": [
            "Native"
          ]
        }
      },
      "required": [
        "language",
        "proficiency"
      ],
      "type": "object"
    },
    "LanguageProficiency": {
      "enum": [
        "Native",
        "Fluent",
        "Intermediate",
        "Basic"
      ],
      "type": "string"
    },
    "ProfileDetails": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "description": "Primary contact email address. (e.g., \"john.doe@example.com\")",
          "examples": [
            "john.doe@example.com"
          ],
          "format": "email",
          "type": "string"
        },
        "github": {
          "description": "URL to GitHub profile. (e.g., \"https://github.com/johndoe\")",
          "examples": [
            "https://github.com/johndoe"
          ],
          "format": "uri",
          "type": [
            "string",
            "null"
          ]
        },
        "linkedin": {
          "description": "URL to LinkedIn profile. (e.g., \"https://linkedin.com/in/johndoe\")",
          "examples": [
            "https://linkedin.com/in/johndoe"
          ],
          "format": "uri",
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "description": "Current geographic location. (e.g., \"London, UK\")",
          "examples": [
            "London, UK"
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Full legal name. (e.g., \"John Doe\")",
          "examples": [
            "John Doe"
          ],
          "minLength": 1,
          "type": "string"
        },
        "phone": {
          "description": "Contact phone number. (e.g., \"+1-234-567-890\")",
          "examples": [
            "+1-234-567-890"
          ],
          "minLength": 1,
          "type": "string"
        },
        "position": {
          "description": "Current professional title. (e.g., \"Software Engineer\")",
          "examples": [
            "Software Engineer"
          ],
          "minLength": 1,
          "type": "string"
        },
        "seniority_level": {
          "description": "Professional seniority level. (e.g., \"Senior\")",
          "examples": [
            "Senior"
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "website": {
          "description": "URL to personal portfolio or website. (e.g., \"https://johndoe.com\")",
          "examples": [
            "https://johndoe.com"
          ],
          "format": "uri",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "position",
        "email",
        "phone"
      ],
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "description": "High-level summary of the project. (e.g., \"A full-stack online store...\")",
          "examples": [
            "A full-stack online store built with Next.js and Stripe."
          ],
          "minLength": 1,
          "type": "string"
        },
        "github_url": {
          "description": "Link to source code. (e.g., \"https://github.com/user/repo\")",
          "examples": [
            "https://github.com/johndoe/shop"
          ],
          "format": "uri",
          "type": [
            "string",
            "null"
          ]
        },
        "live_url": {
          "description": "Link to live application. (e.g., \"https://demo.com\")",
          "examples": [
            "https://shop-demo.com"
          ],
          "format": "uri",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Title of the project. (e.g., \"E-commerce Platform\")",
          "examples": [
            "E-commerce Platform"
          ],
          "minLength": 1,
          "type": "string"
        },
        "technologies": {
          "description": "Programming languages and tools used. (e.g., [\"React\", \"Node.js\"])",
          "examples": [
            [
              "React",
              "Node.js",
              "PostgreSQL"
            ]
          ],
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "name",
        "description",
        "technologies"
      ],
      "type": "object"
    },
    "Skills": {
      "additionalProperties": {
        "description": "Categorized list of skills. (e.g., {\"Languages\": [\"TypeScript\"]})",
        "examples": [
          {
            "Languages": [
              "TypeScript",
              "Python"
            ],
            "Tools": [
              "Git",
              "Docker"
            ]
          }
        ],
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "type": "object"
    }
  }
}